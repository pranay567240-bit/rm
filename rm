P7 CODE
data(mtcars)
y=mtcars$mpg
x1=mtcars$cyl
x2=mtcars$disp
x3=mtcars$hp
x4=mtcars$wt
x5=mtcars$am
x6=mtcars$gear
model<-lm(y~x1+x2+x3+x4+x5+x6)
summary(model)
plot(model)
library(lmtest)
bptest(model)
y1=log(y)
model_log=lm(y1~x1+x2+x3+x4+x5+x6)
summary(model_log)
library(mctest)
mctest(model_log,type="i",method="VIF")
library(glmnet)
cv.glmnet(design,y1)
design=cbind(x1,x2,x3,x4,x5,x6)
library(lmridge)
library(MASS)
ridgemodel<-cv.glmnet(design,y1)
finalridge1=lm.ridge(y1~x1+x2+x3+x4+x5+x6,lambda=ridgemodel$lambda.min)
summary(finalridge1)
coef(finalridge1)


